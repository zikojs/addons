{
  "name": "@zikojs/p5",
  "version": "0.1.0",
  "description": "Reactive p5.js integration wrapper for the ZikoJS framework that turns p5.js sketches into native, state-driven UI components",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "cross-env NODE_ENV=development rollup --config rollup.config.js",
    "watch": "cross-env NODE_ENV=development rollup --config rollup.config.js -w",
    "build": "cross-env NODE_ENV=production rollup --config rollup.config.js"
  },
  "author": "zakaria elaloui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zikojs/addons.git",
    "directory": "packages/p5"
  },
  "keywords": [
    "zikojs",
    "p5js",
    "canvas"
  ],
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/index.d.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "LICENCE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "catalog:",
    "@rollup/plugin-node-resolve": "catalog:",
    "@rollup/plugin-terser": "catalog:",
    "cross-env": "catalog:",
    "rollup": "catalog:"
  },
  "dependencies": {
    "p5": "^2.3.3",
    "zextra": "catalog:",
    "ziko": "catalog:"
  }
}
